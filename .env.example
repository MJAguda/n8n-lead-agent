# Copy to .env and fill in. Everything here is free.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Postgres (the CRM). Change the password for anything beyond a local demo.
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me

# Google OAuth client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: http://localhost:5678/rest/oauth2-credential/callback
# Enable the Google Calendar API and the Gmail API on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendar the agent books into: your Gmail address, or a calendar ID from Google Calendar > Settings > Integrate calendar.
CALENDAR_ID=

# Where hot-lead, emergency and handoff alerts go.
STAFF_EMAIL=

# Public URL of n8n. Keep the default locally; set it to your domain or tunnel URL when deployed.
WEBHOOK_URL=http://localhost:5678/
