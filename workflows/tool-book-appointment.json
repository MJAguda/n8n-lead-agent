      "id": "f3fe240d-c093-418c-a7f4-dd6df5deefa5",
      "name": "Get Free Slots",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-checks the requested start against live availability right before booking.\nconst req = $('When Executed by Another Workflow').first().json;\nconst lead = $('Load Lead').first().json || {};\nconst slots = $input.first().json.slots ?? [];\nconst refuse = (message, alternatives = []) => [{ json: { free: false, message, alternatives } }];\n\nif (!lead.id || !lead.name || !(lead.phone || lead.email)) {\n  return refuse(\"Call save_lead with the patient's name and a phone number or email before booking.\");\n}\nconst wanted = DateTime.fromISO(String(req.start ?? ''));\nif (!wanted.isValid) return refuse('start must be the exact ISO start value of a slot from check_availability.');\n\nconst slot = slots.find((s) => DateTime.fromISO(s.start).toMillis() === wanted.toMillis());\nif (!slot) return refuse('That time is no longer available. Offer the patient one of the alternatives.', slots.slice(0, 3));\n\nreturn [{ json: {\n  free: true, start: slot.start, end: slot.end, label: slot.label, service: req.service,\n  session_id: req.session_id, lead_id: lead.id, name: lead.name, phone: lead.phone, email: lead.email,\n} }];\n"
      },
      "id": "8e3b3bd4-d817-418a-9526-d2269d56a4c2",
      "name": "Verify Slot",
