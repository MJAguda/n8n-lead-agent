            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Lead": {
      "main": [
        [
          {
            "node": "Email Staff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Staff": {
      "main": [
        [
          {
            "node": "Result",
